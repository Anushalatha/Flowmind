# Add a key for the provider selected below to enable LLM-backed workflows.
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
HUGGINGFACE_API_KEY=

PLANNER_MODEL=llama-3.1-8b-instant
